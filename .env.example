# SQLite file for local dev. For production use a libSQL/Turso URL, e.g. libsql://your-db.turso.io
DATABASE_URL=file:./data/belovedtan.db
DATABASE_AUTH_TOKEN=

# Signs admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# First admin account, created by `npm run db:seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
